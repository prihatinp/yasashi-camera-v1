# Copy file ini menjadi ".env" lalu isi dengan nilai asli dari project Supabase kamu.
# JANGAN commit file ".env" (sudah masuk .gitignore).

# Supabase Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Catatan:
# - HF_API_TOKEN dan SUPABASE_SERVICE_ROLE_KEY TIDAK boleh ada di sini / di frontend.
#   Keduanya hanya di-set sebagai Supabase Edge Function secret lewat:
#     supabase secrets set HF_API_TOKEN=hf_xxxxxxxxxxxxxxxx
